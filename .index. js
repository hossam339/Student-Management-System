
class Student {
    constructor(id, name, grades, attendance) {
        this.id = id;
        this.name = name;
        this.grades = grades;
        this.attendance = attendance;
    }

    // حساب متوسط الدرجات باستخدام reduce
    calculateAverage() {
        const total = this.grades.reduce((sum, grade) => {
            return sum + grade;
        }, 0);

        return total / this.grades.length;
    }

    // تحديد التقدير بالحروف
    getGrade(average) {
        if (average >= 90) {
            return "A";
        } else if (average >= 80) {
            return "B";
        } else if (average >= 70) {
            return "C";
        } else if (average >= 60) {
            return "D";
        } else if (average >= 50) {
            return "E";
        } else {
            return "F";
        }
    }

    // تحديد النتيجة النهائية
    getFinalResult(average) {
        if (average >= 50 && this.attendance >= 75) {
            return "ناجح";
        } else {
            return "يحتاج مراجعة";
        }
    }
}

// إنشاء مصفوفة الطلاب الرئيسية
const studentsList = [
    new Student(101, "Ahmed", [90, 85, 95], 95),
    new Student(102, "Sara", [45, 48, 42], 90),
    new Student(103, "Omar", [60, 65, 70], 70),
    new Student(104, "Mariam", [40, 44, 46], 80)
];

// استخراج الطلاب المتعثرين باستخدام filter
const strugglingStudents = studentsList.filter(student => {
    const average = student.calculateAverage();

    return average >= 40 && average <= 49;
});

// إضافة 5 درجات رأفة باستخدام map
const mercyStudents = strugglingStudents.map(student => {
    const oldAverage = student.calculateAverage();

    return {
        id: student.id,
        name: student.name,
        oldAverage: oldAverage,
        newAverage: Math.min(oldAverage + 5, 100)
    };
});

// جمع المتوسطات الجديدة باستخدام reduce
const totalMercyGrades = mercyStudents.reduce((sum, student) => {
    return sum + student.newAverage;
}, 0);

// حساب متوسط الرأفة مع الحماية من القسمة على صفر
const mercyAverage = mercyStudents.length > 0
    ? totalMercyGrades / mercyStudents.length
    : 0;

// طباعة تقرير كل طالب
console.log("===== University Students Report =====");

studentsList.forEach(student => {
    const average = student.calculateAverage();
    const grade = student.getGrade(average);
    const result = student.getFinalResult(average);

    console.log("-----------------------------");
    console.log("Student Name:", student.name);
    console.log("Average:", average.toFixed(2));
    console.log("Grade:", grade);
    console.log("Final Result:", result);
});

// طباعة الطلاب المستفيدين من الرأفة
console.log("===== Mercy Committee Students =====");
console.log(mercyStudents);

// طباعة متوسط درجات الطلاب بعد الرأفة
console.log("===== Mercy Average =====");
console.log(mercyAverage.toFixed(2));
